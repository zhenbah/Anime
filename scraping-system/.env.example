.env.example
# Security
SECRET_KEY=change-this-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
MONGODB_URL=mongodb://admin:password@localhost:27017/scraping_db?authSource=admin
MONGODB_DB=scraping_db
REDIS_URL=redis://localhost:6379

# API
API_V1_STR=/api/v1
DEBUG=False

# Scraping
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT=30
RETRY_COUNT=3
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Proxy
PROXY_ENABLED=False
# PROXY_LIST=proxy1:port,proxy2:port

# Browser
HEADLESS=True
BROWSER_TIMEOUT=60

# Queue
QUEUE_NAME=scraping_queue
PRIORITY_QUEUE_NAME=scraping_priority_queue

# Monitoring
LOG_LEVEL=INFO
METRICS_ENABLED=True

# Scheduler
SCHEDULER_ENABLED=True

# CORS
CORS_ORIGINS=*
